[ext_resource type="PackedScene" path="res://scenes/title/save_list.tscn" id="7_save_list"]
[ext_resource type="PackedScene" path="res://scenes/title/invaders/invaders_page.tscn" id="8_invaders"]

[sub_resource type="StyleBoxEmpty" id="StyleBoxEmpty_subtitle_indent"]
content_margin_left = 4.0

[node name="TitleScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_title_screen")

[node name="Background" type="TextureRect" parent="."]
layout_mode = 0
offset_right = 640.0
offset_bottom = 360.0
texture = ExtResource("2_title_t02")

[node name="LogoBlock" type="VBoxContainer" parent="."]
layout_mode = 0
offset_left = 14.0
offset_top = 12.0
offset_right = 296.0
offset_bottom = 83.0
theme_override_constants/separation = 4

[node name="Logo" type="TextureRect" parent="LogoBlock"]
custom_minimum_size = Vector2(282, 54)
layout_mode = 2
size_flags_horizontal = 0
texture = ExtResource("3_logo")

[node name="Shadow" type="TextureRect" parent="LogoBlock/Logo"]
show_behind_parent = true
layout_mode = 0
offset_left = 2.0
offset_top = 2.0
offset_right = 284.0
offset_bottom = 56.0
mouse_filter = 2

[node name="Subtitle" type="Label" parent="LogoBlock"]
layout_mode = 2
theme_type_variation = &"Subtitle"
theme_override_styles/normal = SubResource("StyleBoxEmpty_subtitle_indent")
text = "WIRTSCHAFTSSIMULATION · 1985–1999"


[node name="VersionLine" type="Label" parent="."]
layout_mode = 1
anchors_preset = 1
anchor_left = 1.0
anchor_right = 1.0
offset_left = -16.0
offset_top = 16.0
offset_right = -16.0
offset_bottom = 29.0
grow_horizontal = 0
theme_type_variation = &"VersionLine"
horizontal_alignment = 2

[node name="Communicator" parent="." instance=ExtResource("5_communicator")]
layout_mode = 0
offset_left = 244.0
offset_top = 92.0
offset_right = 636.0
offset_bottom = 360.0
case_keys = Array[Rect2i]([Rect2i(140, 114, 11, 8), Rect2i(154, 114, 12, 8), Rect2i(169, 114, 12, 8)])

[node name="MainMenu" parent="Communicator" instance=ExtResource("4_main_menu")]
