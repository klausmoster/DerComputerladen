[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/title/title_screen.gd" id="1_title_screen"]
[ext_resource type="Texture2D" path="res://assets/images/title_t01.png" id="2_title_t01"]
[ext_resource type="Texture2D" path="res://assets/images/logo_ladenschild.png" id="3_logo"]
[ext_resource type="PackedScene" path="res://scenes/title/main_menu.tscn" id="4_main_menu"]
[ext_resource type="Script" path="res://scenes/title/menu_entry.gd" id="5_menu_entry"]
[ext_resource type="PackedScene" path="res://scenes/title/menu_hint.tscn" id="6_menu_hint"]

[sub_resource type="StyleBoxEmpty" id="StyleBoxEmpty_subtitle_indent"]
content_margin_left = 4.0

[sub_resource type="Resource" id="Resource_new_game"]
script = ExtResource("5_menu_entry")
id = &"new_game"
label = "Neues Spiel"
hint = "Der Laden hat noch zu. Bald kannst du ihn eröffnen."

[sub_resource type="Resource" id="Resource_load_game"]
script = ExtResource("5_menu_entry")
id = &"load_game"
label = "Spiel laden"
hint = "Noch keine Spielstände. Speichern kommt bald."

[sub_resource type="Resource" id="Resource_settings"]
script = ExtResource("5_menu_entry")
id = &"settings"
label = "Einstellungen"
hint = "Noch nichts einzustellen. Kommt später."

[sub_resource type="Resource" id="Resource_quit"]
script = ExtResource("5_menu_entry")
id = &"quit"
label = "Beenden"
available = true
hint = "Laden abschließen und zurück zum Desktop."

[node name="TitleScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_title_screen")

[node name="Background" type="TextureRect" parent="."]
layout_mode = 0
offset_right = 640.0
offset_bottom = 360.0
texture = ExtResource("2_title_t01")

[node name="LogoBlock" type="VBoxContainer" parent="."]
layout_mode = 0
offset_left = 14.0
offset_top = 12.0
offset_right = 296.0
offset_bottom = 83.0
theme_override_constants/separation = 4

[node name="Logo" type="TextureRect" parent="LogoBlock"]
custom_minimum_size = Vector2(282, 54)
layout_mode = 2
size_flags_horizontal = 0
texture = ExtResource("3_logo")

[node name="Subtitle" type="Label" parent="LogoBlock"]
layout_mode = 2
theme_type_variation = &"Subtitle"
theme_override_styles/normal = SubResource("StyleBoxEmpty_subtitle_indent")
text = "WIRTSCHAFTSSIMULATION · 1985–1999"

[node name="MainMenu" parent="." instance=ExtResource("4_main_menu")]
layout_mode = 0
offset_left = 472.0
offset_top = 150.0
offset_right = 616.0
offset_bottom = 250.0
entries = Array[ExtResource("5_menu_entry")]([SubResource("Resource_new_game"), SubResource("Resource_load_game"), SubResource("Resource_settings"), SubResource("Resource_quit")])

[node name="MenuHint" parent="." instance=ExtResource("6_menu_hint")]
layout_mode = 0

[node name="VersionLine" type="Label" parent="."]
layout_mode = 1
anchors_preset = 2
anchor_top = 1.0
anchor_bottom = 1.0
offset_left = 16.0
offset_top = -19.0
offset_right = 16.0
offset_bottom = -6.0
grow_vertical = 0
theme_type_variation = &"VersionLine"

[connection signal="entry_activated" from="MainMenu" to="." method="_on_main_menu_entry_activated"]
[connection signal="selection_changed" from="MainMenu" to="." method="_on_main_menu_selection_changed"]
