[gd_scene format=3]

[ext_resource type="Script" path="res://tools/werkstatt/difficulty_panel.gd" id="1_difficulty"]

[node name="DifficultyPanel" type="VBoxContainer"]
script = ExtResource("1_difficulty")

[node name="Scroll" type="ScrollContainer" parent="."]
clip_contents = false
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0
vertical_scroll_mode = 0

[node name="Content" type="VBoxContainer" parent="Scroll"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="TopBar" type="HBoxContainer" parent="Scroll/Content"]
layout_mode = 2

[node name="DifficultyCaption" type="Label" parent="Scroll/Content/TopBar"]
layout_mode = 2
text = "Grad"

[node name="DifficultyOption" type="OptionButton" parent="Scroll/Content/TopBar"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Das Profil dieses Grads zeigen. Mittel ist der Katalog selbst und hat kein Profil."
selected = 0
item_count = 3
popup/item_0/text = "Leicht"
popup/item_0/id = 0
popup/item_1/text = "Mittel"
popup/item_1/id = 1
popup/item_2/text = "Schwer"
popup/item_2/id = 2

[node name="CountLabel" type="Label" parent="Scroll/Content/TopBar"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedLabel"

[node name="MittelNote" type="Label" parent="Scroll/Content"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "Mittel ist der Katalog ohne Start-Modifikatoren. Seine Chancen sind die Grundchancen der Ereignisse."
autowrap_mode = 3

[node name="Split" type="HSplitContainer" parent="Scroll/Content"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3

[node name="TableBox" type="VBoxContainer" parent="Scroll/Content/Split"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_stretch_ratio = 2.3

[node name="Table" type="Tree" parent="Scroll/Content/Split/TableBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 80)
layout_mode = 2
size_flags_vertical = 3

[node name="TableButtons" type="HBoxContainer" parent="Scroll/Content/Split/TableBox"]
layout_mode = 2

[node name="NewButton" type="Button" parent="Scroll/Content/Split/TableBox/TableButtons"]
unique_name_in_owner = true
layout_mode = 2
text = "Neu"

[node name="DuplicateButton" type="Button" parent="Scroll/Content/Split/TableBox/TableButtons"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Den gewählten Start-Modifikator direkt dahinter kopieren"
text = "Duplizieren"

[node name="DeleteButton" type="Button" parent="Scroll/Content/Split/TableBox/TableButtons"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Den gewählten Start-Modifikator löschen; Rückgängig holt ihn zurück"
text = "Löschen"

[node name="Fields" type="GridContainer" parent="Scroll/Content/Split"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
columns = 2

[node name="EventCaption" type="Label" parent="Scroll/Content/Split/Fields"]
layout_mode = 2
text = "Ereignis"

[node name="EventCell" type="VBoxContainer" parent="Scroll/Content/Split/Fields"]
layout_mode = 2
size_flags_horizontal = 3

[node name="EventOption" type="OptionButton" parent="Scroll/Content/Split/Fields/EventCell"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
clip_text = true
fit_to_longest_item = false

[node name="EventHint" type="Label" parent="Scroll/Content/Split/Fields/EventCell"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"ErrorLabel"
autowrap_mode = 3

[node name="ValueCaption" type="Label" parent="Scroll/Content/Split/Fields"]
