autowrap_mode = 3

[node name="DetailText" type="Label" parent="Split/PlanSplit/DetailScroll/Detail"]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 3

[node name="ProtocolBox" type="VSplitContainer" parent="Split"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Protocol" type="Tree" parent="Split/ProtocolBox"]
