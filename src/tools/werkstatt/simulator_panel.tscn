[node name="InterventionBox" type="VBoxContainer" parent="Split/ProtocolBox"]
unique_name_in_owner = true
layout_mode = 2

[node name="InterventionHead" type="HFlowContainer" parent="Split/ProtocolBox/InterventionBox"]
