theme_type_variation = &"MutedLabel"

[node name="ModifierButton" type="Button" parent="Split/ProtocolBox/InterventionBox/InterventionHead"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Die Chance eines Ereignisses über Wahrscheinlichkeit für eine Zeit verschieben"
text = "Modifikator …"

[node name="ScheduleButton" type="Button" parent="Split/ProtocolBox/InterventionBox/InterventionHead"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Ein Ereignis, das weder fix noch jährlich ist, mit Grund an einem Tag einplanen"
text = "Einplanen …"

[node name="ModifierList" type="Tree" parent="Split/ProtocolBox/InterventionBox"]
